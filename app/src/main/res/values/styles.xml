<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ContenedorPantalla">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">2</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">bottom</item>
        <item name="android:padding">20dp</item>
        <item name="android:background">@color/pantalla_fondo</item>
    </style>
    <style name="PantallaPrincipal">
    </style>
    <style name="Theme.Calculadora" parent="Theme.Material3.DayNight.NoActionBar"></style>
    <style name="PantallaExpresion">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:minHeight">24dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/expresion_texto</item>
    </style>
    <style name="IndicadorMemoria">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/memoria_indicador</item>
        <item name="android:visibility">invisible</item>
    </style>

    <style name="Teclado">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">5</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="Fila">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="BotonBase" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/texto_boton</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">22dp</item>
    </style>
    <style name="BotonNumero" parent="BotonBase">
        <item name="backgroundTint">@color/boton_numero</item>
    </style>
    <style name="BotonOperador" parent="BotonBase">
        <item name="backgroundTint">@color/boton_operador</item>
        <item name="android:textSize">28sp</item>
    </style>
    <style name="BotonMemoria" parent="BotonBase">
        <item name="backgroundTint">@color/boton_memoria</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="BotonLimpiar" parent="BotonBase">
        <item name="backgroundTint">@color/boton_limpiar</item>
    </style>
    <style name="BotonIgual" parent="BotonBase">
        <item name="backgroundTint">@color/boton_igual</item>
        <item name="android:textColor">@color/texto_igual</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="BotonNumeroLand" parent="Widget.Material3.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="FilaLand">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginLeft">25dp</item>
        <item name="android:layout_marginRight">25dp</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">horizontal</item>
    </style>

</resources>